{
  "name": "tanstack-start-powersync-postgres-tanstack-db",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "dev": "vite dev",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down -v",
    "db:reset": "docker compose down -v && docker compose up -d",
    "db:logs": "docker compose logs -f postgres powersync",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "typecheck": "tsc --noEmit",
    "powersync:token": "powersync generate token --directory=powersync --subject=demo-user"
  },
  "dependencies": {
    "@journeyapps/wa-sqlite": "^1.4.1",
    "@powersync/react": "^1.8.2",
    "@powersync/web": "^1.31.0",
    "@tanstack/db": "^0.5.18",
    "@tanstack/powersync-db-collection": "^0.1.20",
    "@tanstack/react-db": "^0.1.60",
    "@tanstack/react-router": "^1.166.8",
    "@tanstack/react-start": "^1.166.8",
    "jose": "^6.1.2",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.52.1",
    "@eslint/js": "^9.38.0",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.38.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^7.1.12",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.4.1",
    "vite-tsconfig-paths": "^6.0.0",
    "wrangler": "4.123.0"
  }
}
